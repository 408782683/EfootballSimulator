{
  "name": "football-simulator",
  "private": true,
  "version": "0.0.0",
  "description": "eFootball 风格的球王传承连锁礼包抽卡模拟器",
  "author": "FootballSimulator",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "electron": "electron .",
    "dist": "npm run build && electron-builder --win --x64"
  },
  "build": {
    "appId": "com.footballsimulator.packsim",
    "productName": "FootballPackSimulator",
    "directories": {
      "output": "release-out"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraFiles": [
      {
        "from": "packaging/启动游戏.bat",
        "to": "启动游戏.bat"
      }
    ],
    "win": {
      "signAndEditExecutable": false,
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  },
  "dependencies": {
    "vue": "^3.5.21"
  },
  "devDependencies": {
    "@types/node": "^24.5.2",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/tsconfig": "^0.7.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vue-tsc": "^3.0.6"
  }
}
