{
  // Cloudflare Workers 静态资源配置（新版 Workers 部署方式 / Workers Builds）
  // 将 npm run build 产出的 dist/ 作为静态资源直接部署，无需单独编写 Worker 脚本
  // 注意：name 必须与 Cloudflare 控制台中的 Worker / 项目名称保持一致
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "efootballsimulator",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    // 单页应用：未命中的路径统一回退到 index.html
    "not_found_handling": "single-page-application"
  },
  "observability": {
    "enabled": true
  }
}
